msgstr "Категория документа"

msgid "Department"
msgstr "Структурное подразделение"

msgid "Issuing authority"
msgstr "Издавший орган"

msgid "Search %s"
msgstr "Найти %s"

msgid "All %s"
msgstr "Все %s"

msgid "Edit %s"
msgstr "Изменить %s"

msgid "Update %s"
msgstr "Обновить %s"

msgid "Add new %s"
msgstr "Добавить новый %s"

