msgstr "SHA-256"

msgid "Original"
msgstr "Оригинал"

msgid "Verify"
msgstr "Проверка"

msgid "Source PDF is not readable."
msgstr "Исходный PDF не читается."

msgid "Signing requires browser PDF processing. Enable JavaScript and make sure the bundled PDF libraries are available."
msgstr "Подписание PDF требует браузерной обработки. Включите JavaScript и убедитесь, что встроенные PDF-библиотеки доступны."

msgid "Invalid signed document."
msgstr "Некорректный подписанный документ."

msgid "Stamped PDF is not readable."
msgstr "PDF с отметкой не читается."

msgid "This document is not waiting for a public PDF copy."
msgstr "Этот документ не ожидает публичную PDF-копию."

msgid "Original PDF is missing."
msgstr "Исходный PDF отсутствует."

msgid "Original PDF hash does not match the stored document hash."
msgstr "Хеш исходного PDF не совпадает с сохранённым хешем документа."

msgid "Document verification data is incomplete."
msgstr "Данные проверки документа неполны."

msgid "Failed to calculate SHA-256 for the public PDF copy."
msgstr "Не удалось вычислить SHA-256 публичной PDF-копии."

