msgstr "Не удалось сохранить исходный PDF."

msgid "Failed to save the public PDF copy."
msgstr "Не удалось сохранить публичную PDF-копию."

msgid "Signing the PDF requires browser processing. Enable JavaScript and check the bundled PDF libraries in assets/vendor."
msgstr "Подписание PDF требует браузерной обработки. Включите JavaScript и проверьте bundled PDF-библиотеки в assets/vendor."

msgid "Failed to calculate SHA-256 for the original PDF."
msgstr "Не удалось вычислить SHA-256 исходного PDF."

msgid "The document could not be signed."
msgstr "Не удалось подписать документ."

msgid "Sign Docs"
msgstr "Документы"

msgid "Document signing and metadata helpers."
msgstr "Помощники для подписания документов и заполнения реквизитов."

msgid "Suggest signed document metadata"
msgstr "Подсказать реквизиты подписанного документа"

msgid "Suggests document category, type, institution, date, number, subject, and titles from the first page text of an educational organization PDF."
msgstr "Предлагает категорию, вид, институцию, дату, номер, предмет и названия документа по тексту первой страницы PDF образовательной организации."

msgid "The first page text is too short for reliable AI suggestions."
msgstr "Текст первой страницы слишком короток для надёжных AI-подсказок."

msgid "The WordPress AI Client is not available."
msgstr "AI-клиент WordPress недоступен."

msgid "No approved AI connector with text generation support is available."
msgstr "Нет одобренного AI-коннектора с поддержкой генерации текста."

msgid "The AI response could not be parsed as JSON."
msgstr "Ответ AI не удалось разобрать как JSON."

msgid "Text extracted from the first page of the PDF."
msgstr "Текст, извлечённый с первой страницы PDF."

msgid "Original uploaded PDF file name."
msgstr "Имя загруженного исходного PDF-файла."

msgid "Download"
msgstr "Скачать"

msgid "This document is not currently in force. Use the verification page to check its status."
msgstr "Документ не является действующим. Используйте страницу проверки для уточнения статуса."

msgid "Signature"
msgstr "Подпись"

msgid "The document is signed with a simple electronic signature"
msgstr "Документ подписан простой электронной подписью"

msgid "Record ID:"
msgstr "ID записи:"

msgid "Signature date:"
msgstr "Дата подписи:"

msgid "Signed by"
msgstr "Подписал"

